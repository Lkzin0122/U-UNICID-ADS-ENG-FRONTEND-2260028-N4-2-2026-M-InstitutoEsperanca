# Na Vercel, o padrão é Groq. Cadastre a chave apenas nas variáveis do servidor.
# AI_PROVIDER=groq
# GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b
# AI_TIMEOUT_MS=45000

# Alternativa opcional: AI_PROVIDER=vercel, AI_MODEL e AI_GATEWAY_API_KEY.
# O AI Gateway desta conta exige a ativação da Vercel com cartão.

# Fora da Vercel, o padrão é Ollama local, sem chave de API.
# Execute: ollama pull qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=120000
PORT=3000
