# Na Vercel, o AI Gateway é escolhido automaticamente.
# AI_PROVIDER=vercel
# AI_MODEL=google/gemini-2.5-flash-lite
# AI_GATEWAY_API_KEY=  # Opcional quando a autenticação OIDC da Vercel está ativa.
# AI_TIMEOUT_MS=45000

# Fora da Vercel, o padrão é Ollama local, sem chave de API.
# Execute: ollama pull qwen3:1.7b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_MS=120000
PORT=3000
